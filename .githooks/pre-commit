#!/usr/bin/env bash
# Block commits that stage a pubspec.yaml without updating direct dependencies.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qx 'pubspec.yaml'; then
  exit 0
fi

if ! command -v dart >/dev/null 2>&1; then
  echo "dart was not found; skipping the outdated dependency check." >&2
  exit 0
fi

exec dart run scripts/check_outdated_deps.dart
